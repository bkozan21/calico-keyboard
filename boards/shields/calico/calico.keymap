// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    // Define a default keymap here.
    // See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap.
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                // ==========================================
                // Row 1: Arrows bottom + thumb row
                // ==========================================
                &kp A &kp A &kp A &kp A &kp A &kp A
                &kp A &kp A &kp A &kp A &kp A &kp A

                // ==========================================
                // Row 2: Arrows top + thumb upper row
                // ==========================================
                &kp A &kp A &kp A &kp A
                &kp A &kp A &kp A &kp A

                // ==========================================
                // Row 3: Main bottom row
                // ==========================================
                &kp A &kp A &kp A &kp A
                &kp A &kp A &kp A &kp A
                &kp A &kp A &kp A &kp A
                &kp A &kp A &kp A &kp A

                // ==========================================
                // Row 4: Home row
                // ==========================================
                &kp A &kp A &kp A &kp A &kp A &kp A
                &kp A &kp A &kp A
                &kp A &kp A &kp A &kp A &kp A &kp A
                &kp A &kp A &kp A

                // ==========================================
                // Row 5: Top row
                // ==========================================
                &kp A &kp A &kp A &kp A &kp A &kp A
                &kp A &kp A &kp A
                &kp A &kp A &kp A &kp A &kp A &kp A
                &kp A &kp A &kp A

                // ==========================================
                // Row 6: Numbers row
                // ==========================================
                &kp A &kp A &kp A &kp A &kp A &kp A
                &kp A &kp A &kp A
                &kp A &kp A &kp A &kp A &kp A &kp A
                &kp A &kp A &kp A

                // ==========================================
                // Row 7: Functions row
                // ==========================================
                &kp A &kp A &kp A &kp A &kp A &kp A
                &kp A &kp A &kp A
                &kp A &kp A &kp A &kp A &kp A &kp A
                &kp A &kp A &kp A
            >;
        };
    };
};
